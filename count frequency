#include <stdio.h>
int main() {
    int arr[100], freq[100], n, i, j;
    printf("Enter size: ");
    scanf("%d",&n);
    for(i=0;i<n;i++) {
        scanf("%d",&arr[i]);
        freq[i] = -1;
    }
    for(i=0;i<n;i++) {
        int count = 1;
        if(freq[i] == 0) continue;
        for(j=i+1;j<n;j++) {
            if(arr[i] == arr[j]) {
                count++;
                freq[j] = 0;
            }
        }
        freq[i] = count;
    }
    for(i=0;i<n;i++) {
        if(freq[i] != 0)
            printf("%d: %d times,\t", arr[i], freq[i]);
    }
}
